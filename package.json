{
  "name": "@ironarachne/word-generator",
  "version": "3.0.1",
  "description": "A library for generation of fictional words",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "check": "npm run lint && npm run build && npm test",
    "docs": "typedoc --out docs src/index.ts",
    "lint": "biome ci src/*.ts",
    "lint:fix": "biome check --fix src/*.ts",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ironarachne/word-generator.git"
  },
  "keywords": [
    "ironarachne",
    "words",
    "generator",
    "phonetics",
    "conlang"
  ],
  "author": "Ben Overmyer <ben@overmyer.net> (https://benovermyer.com/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ironarachne/word-generator/issues"
  },
  "homepage": "https://ironarachne.github.io/word-generator",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@ironarachne/rng": "^3.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "typedoc": "^0.28.15",
    "typescript": "^5.9.0",
    "vitest": "^4.0.15"
  }
}
