  "license": "MIT",
  "bugs": {
    "url": "https://codeberg.org/ironarachne/word-generator/issues"
  },
  "homepage": "https://word-generator.ironarachne.com/docs",
  "dependencies": {
    "@ironarachne/rng": "^2.3.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.22.9",
    "@babel/preset-typescript": "^7.22.5",
    "@biomejs/biome": "2.3.8",
    "ts-node": "^10.9.1",
    "typedoc": "^0.28.15",
    "typescript": "^5.9.0",
    "vitest": "^4.0.15"
  }
